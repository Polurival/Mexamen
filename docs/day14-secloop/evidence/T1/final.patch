+package dev.polurival.mexamen.data
+
+/**
+ * Хранилище Bearer-токена авторизации.
+ * Android: переживает перезапуск, зашифровано (AES-GCM, AndroidKeyStore).
+ * Web: только в памяти, после перезагрузки страницы нужен повторный вход.
+ */
+interface TokenStore {
+    suspend fun saveToken(token: String)
+
+    /** Сохранённый токен или `null`, если пользователь не входил / токен очищен. */
+    suspend fun readToken(): String?
+    suspend fun clearToken()
+}
+
+/** Продакшн-инстанс; Android — DataStore + шифрование, wasm — память. */
+expect fun defaultTokenStore(): TokenStore
