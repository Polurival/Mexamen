+package dev.polurival.mexamen.data
+
+import androidx.datastore.core.DataStore
+import androidx.datastore.preferences.core.PreferenceDataStoreFactory
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.stringPreferencesKey
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.test.runTest
+import java.io.File
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNotEquals
+import kotlin.test.assertNull
+
+/** Настоящий DataStore на временном файле; AndroidKeyStore на хосте недоступен — шифр подменён. */
+class DataStoreTokenStoreTest {
+    private val file = File.createTempFile("auth_token", ".preferences_pb").also { it.delete() }
+    private val rawKey = stringPreferencesKey("auth_token")
+
+    private class ReversingCipher : TokenCipher {
+        override fun encrypt(plain: String) = "enc:" + plain.reversed()
+        override fun decrypt(encoded: String): String {
+            require(encoded.startsWith("enc:"))
+            return encoded.removePrefix("enc:").reversed()
+        }
+    }
+
+    private class BrokenCipher : TokenCipher {
+        override fun encrypt(plain: String) = plain
+        override fun decrypt(encoded: String): String = error("key lost")
+    }
+
+    private fun dataStore(scope: CoroutineScope): DataStore<Preferences> =
+        PreferenceDataStoreFactory.create(scope = scope, produceFile = { file })
+
+    @Test
+    fun tokenSurvivesRestartIsEncryptedAndClearRemovesIt() = runTest {
+        val scope1 = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+        val ds1 = dataStore(scope1)
+        val first = DataStoreTokenStore(ds1, ReversingCipher())
+        assertNull(first.readToken())
+        first.saveToken("test-token")
+        assertEquals("test-token", first.readToken())
+        assertNotEquals("test-token", ds1.data.first()[rawKey])
+        scope1.cancel()
+
+        val scope2 = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+        val second = DataStoreTokenStore(dataStore(scope2), ReversingCipher())
+        assertEquals("test-token", second.readToken())
+        second.clearToken()
+        assertNull(second.readToken())
+        scope2.cancel()
+        file.delete()
+    }
+
+    @Test
+    fun undecryptableTokenIsClearedAndReadReturnsNull() = runTest {
+        val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+        val ds = dataStore(scope)
+        DataStoreTokenStore(ds, ReversingCipher()).saveToken("test-token")
+        val broken = DataStoreTokenStore(ds, BrokenCipher())
+        assertNull(broken.readToken())
+        assertNull(ds.data.first()[rawKey])
+        scope.cancel()
+        file.delete()
+    }
+}
