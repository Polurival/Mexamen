+package dev.polurival.mexamen.data
+
+/**
+ * Токен только в памяти вкладки: в localStorage не пишем (читается любым XSS).
+ * После перезагрузки страницы нужен повторный вход.
+ */
+class InMemoryTokenStore : TokenStore {
+    private var token: String? = null
+
+    override suspend fun saveToken(token: String) {
+        this.token = token
+    }
+
+    override suspend fun readToken(): String? = token
+
+    override suspend fun clearToken() {
+        token = null
+    }
+}
+
+actual fun defaultTokenStore(): TokenStore = InMemoryTokenStore()
