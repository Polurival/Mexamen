+package dev.polurival.mexamen.data
+
+import io.ktor.client.HttpClient
+import io.ktor.client.engine.mock.MockEngine
+import io.ktor.client.engine.mock.respond
+import io.ktor.client.request.HttpRequestData
+import io.ktor.http.HttpHeaders
+import io.ktor.http.HttpMethod
+import io.ktor.http.HttpStatusCode
+import io.ktor.http.headersOf
+import kotlinx.coroutines.test.runTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+import kotlin.test.fail
+
+class StatusClientTest {
+
+    private fun client(
+        apiKey: String? = "test-key",
+        baseUrl: String = StatusClient.DEFAULT_BASE_URL,
+        status: HttpStatusCode = HttpStatusCode.OK,
+        body: String = """{"status":"ok","version":"1.2"}""",
+        capture: (HttpRequestData) -> Unit = {},
+    ) = StatusClient(
+        apiKey = apiKey,
+        baseUrl = baseUrl,
+        client = HttpClient(
+            MockEngine { request ->
+                capture(request)
+                respond(body, status, headersOf(HttpHeaders.ContentType, "application/json"))
+            },
+        ),
+    )
+
+    @Test
+    fun sendsHttpsGetWithKeyHeaderAndNoQueryAndReportsUp() = runTest {
+        var captured: HttpRequestData? = null
+        val result = client(capture = { captured = it }).fetchStatus()
+
+        assertTrue(result.isUp)
+        val request = captured ?: fail("Request was not sent")
+        assertEquals(HttpMethod.Get, request.method)
+        assertEquals("https", request.url.protocol.name)
+        assertEquals("/v1/health", request.url.encodedPath)
+        assertTrue(request.url.parameters.isEmpty(), "No query parameters expected")
+        assertEquals("test-key", request.headers[StatusClient.API_KEY_HEADER])
+    }
+
+    @Test
+    fun plainHttpToRemoteHostIsRejectedWithoutHttpCall() = runTest {
+        var called = false
+        for (url in listOf("http://status.mexamen-api.example", "http://localhost.evil.example", "ftp://x")) {
+            assertFailsWith<StatusUnavailable> {
+                client(baseUrl = url, capture = { called = true }).fetchStatus()
+            }
+        }
+        assertFalse(called, "HTTP must not be called for insecure base URL")
+    }
+
+    @Test
+    fun plainHttpToLoopbackIsAllowed() = runTest {
+        for (url in listOf("http://localhost:8080", "http://127.0.0.1", "http://10.0.2.2:3000")) {
+            assertTrue(client(baseUrl = url).fetchStatus().isUp, url)
+        }
+    }
+
+    @Test
+    fun nonOkStatusIsNotUp() = runTest {
+        assertFalse(client(body = """{"status":"degraded"}""").fetchStatus().isUp)
+    }
+
+    @Test
+    fun missingKeyFailsFastWithoutHttpCall() = runTest {
+        var called = false
+        assertFailsWith<StatusUnavailable> { client(apiKey = null, capture = { called = true }).fetchStatus() }
+        assertFailsWith<StatusUnavailable> { client(apiKey = " ", capture = { called = true }).fetchStatus() }
+        assertFalse(called)
+    }
+
+    @Test
+    fun httpErrorBecomesStatusUnavailable() = runTest {
+        val failure = assertFailsWith<StatusUnavailable> {
+            client(status = HttpStatusCode.Unauthorized).fetchStatus()
+        }
+        assertTrue(failure.message!!.contains("401"))
+    }
+
+    @Test
+    fun unparseableBodyBecomesStatusUnavailable() = runTest {
+        assertFailsWith<StatusUnavailable> { client(body = "not json {").fetchStatus() }
+    }
+}
