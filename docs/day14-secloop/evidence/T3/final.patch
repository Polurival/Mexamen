+package dev.polurival.mexamen.data
+
+import io.ktor.client.HttpClient
+import io.ktor.client.plugins.HttpTimeout
+import io.ktor.client.request.get
+import io.ktor.client.request.header
+import io.ktor.client.statement.bodyAsText
+import io.ktor.http.isSuccess
+import kotlinx.coroutines.CancellationException
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+
+/** Статус сервиса: [status] — сырое значение поля `status` ответа, [isUp] — сервис работает. */
+data class ServiceStatus(val status: String) {
+    val isUp: Boolean get() = status.equals(STATUS_OK, ignoreCase = true)
+
+    companion object {
+        const val STATUS_OK = "ok"
+    }
+}
+
+/** Сервис статуса недоступен или ответил ошибкой/нечитаемым телом. */
+class StatusUnavailable(message: String, cause: Throwable? = null) : Exception(message, cause)
+
+/**
+ * Клиент `GET /v1/health` API статуса сервиса.
+ * Ключ приходит снаружи ([apiKey]) и в код не зашивается; пустой ключ → [StatusUnavailable] без HTTP-вызова.
+ * Формат ответа предполагается `{"status":"ok"}` — уточнить по документации сервиса.
+ */
+class StatusClient(
+    private val apiKey: String?,
+    private val baseUrl: String = DEFAULT_BASE_URL,
+    private val client: HttpClient = defaultClient(),
+) {
+
+    suspend fun fetchStatus(): ServiceStatus {
+        val key = apiKey?.takeIf { it.isNotBlank() }
+            ?: throw StatusUnavailable("Status API key is not configured")
+        if (!isAllowedBaseUrl(baseUrl)) {
+            throw StatusUnavailable("Status base URL must use https")
+        }
+        val response = try {
+            client.get("$baseUrl$HEALTH_PATH") {
+                header(API_KEY_HEADER, key)
+            }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            throw StatusUnavailable("Status request failed: ${e.message}", e)
+        }
+        if (!response.status.isSuccess()) {
+            throw StatusUnavailable("Status HTTP ${response.status.value}")
+        }
+        return try {
+            ServiceStatus(json.decodeFromString<HealthResponse>(response.bodyAsText()).status)
+        } catch (e: Exception) {
+            throw StatusUnavailable("Unparseable status response: ${e.message}", e)
+        }
+    }
+
+    @Serializable
+    private data class HealthResponse(val status: String)
+
+    companion object {
+        const val DEFAULT_BASE_URL = "https://status.mexamen-api.example"
+        const val HEALTH_PATH = "/v1/health"
+        const val API_KEY_HEADER = "X-Api-Key"
+        const val TIMEOUT_MILLIS = 10_000L
+
+        private const val HTTPS_PREFIX = "https://"
+        private const val HTTP_PREFIX = "http://"
+        private val LOOPBACK_HOSTS = listOf("localhost", "127.0.0.1", "10.0.2.2")
+
+        private val json = Json { ignoreUnknownKeys = true }
+
+        /** Ключ уходит только по https; обычный http допустим лишь для loopback-хостов (отладка). */
+        internal fun isAllowedBaseUrl(url: String): Boolean {
+            if (url.startsWith(HTTPS_PREFIX, ignoreCase = true)) return true
+            if (!url.startsWith(HTTP_PREFIX, ignoreCase = true)) return false
+            val authority = url.substring(HTTP_PREFIX.length).substringBefore('/')
+            return authority.substringBefore(':').lowercase() in LOOPBACK_HOSTS
+        }
+
+        private fun defaultClient(): HttpClient = HttpClient {
+            install(HttpTimeout) {
+                requestTimeoutMillis = TIMEOUT_MILLIS
+            }
+        }
+    }
+}
