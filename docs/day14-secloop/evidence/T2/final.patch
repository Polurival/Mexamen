+package dev.polurival.mexamen.llm
+
+import io.ktor.client.HttpClient
+import io.ktor.client.engine.mock.MockEngine
+import io.ktor.client.engine.mock.respond
+import io.ktor.http.HttpHeaders
+import io.ktor.http.HttpStatusCode
+import io.ktor.http.headersOf
+import kotlinx.coroutines.test.runTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+private const val TEST_KEY = "test-groq-key-for-masking"
+
+class HttpLogBufferTest {
+
+    @Test
+    fun logsMethodUrlHeadersAndBodiesButMasksAuthorization() = runTest {
+        val buffer = HttpLogBuffer()
+        val provider = GroqProvider(
+            apiKey = TEST_KEY,
+            client = HttpClient(
+                MockEngine {
+                    respond(
+                        """{"choices":[{"message":{"role":"assistant","content":"respuesta-unica"}}]}""",
+                        HttpStatusCode.OK,
+                        headersOf(HttpHeaders.ContentType, "application/json"),
+                    )
+                },
+            ) { installHttpLogging(buffer) },
+        )
+
+        provider.complete("sistema", "pregunta-unica")
+
+        val log = buffer.dump()
+        assertTrue(log.contains("POST"), log)
+        assertTrue(log.contains(GroqProvider.API_URL), log)
+        assertTrue(log.contains("pregunta-unica"), log)
+        assertTrue(log.contains("respuesta-unica"), log)
+        assertTrue(log.contains(HttpHeaders.Authorization), log)
+        assertFalse(log.contains(TEST_KEY), log)
+    }
+
+    @Test
+    fun keepsOnlyLastLinesWithinCapacity() {
+        val buffer = HttpLogBuffer(capacity = 3)
+        (1..5).forEach { buffer.append("line$it") }
+
+        assertEquals(listOf("line3", "line4", "line5"), buffer.lines.value)
+    }
+}
